<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    
    <!-- Límite Institucional UNIMAR (Contenedor Mayor) -->
    <mxCell id="c_unimar_boundary" value="&lt;b&gt;Límite de Infraestructura de SKMS-Unimar&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=25;html=1;rounded=1;arcSize=6;" vertex="1" parent="1">
      <mxGeometry x="200" y="40" width="880" height="600" as="geometry"/>
    </mxCell>

    <!-- CLIENTE WEB (NAVEGADOR) - Contenedor Mediano -->
    <mxCell id="c_browser" value="&lt;b&gt;CLIENTE WEB (NAVEGADOR)&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f0fdfa;strokeColor=#99f6e4;strokeWidth=2;html=1;rounded=1;arcSize=8;" vertex="1" parent="c_unimar_boundary">

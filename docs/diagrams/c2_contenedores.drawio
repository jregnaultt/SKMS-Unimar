      <mxGeometry x="20" y="20" width="60" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="lbl_blade" value="&lt;b&gt;Vistas Blade (SSR)&lt;/b&gt;&lt;br&gt;HTML5 &amp;amp; Tailwind CSS v3&lt;br&gt;&lt;font color='#64748b'&gt;Renderizado de la interfaz monolítica en el servidor con estilos optimizados.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="grp_blade">
      <mxGeometry x="90" y="10" width="200" height="80" as="geometry"/>
